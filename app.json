{
  "expo": {
    "name": "Deritiva",
    "slug": "deritiva-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/deritiva.png",
    "scheme": "deritivaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.quezinhacosta.deritivaapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/deritiva.png",
        "backgroundColor": "#601938"
      }
    },
    "splash": {
      "image": "./assets/images/deritiva.png",
      "resizeMode": "contain",
      "backgroundColor": "#601938"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/deritiva.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/deritiva.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#601938"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d07ad612-d0d9-4a27-b40b-4f1f0f3cabe5"
      }
    }
  }
}